# Environment Type (development or production)
ENV=development

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=transaction_intelligence

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379

# Google Gemini API Config
# Provide your key here to enable LLM-based categorization & summaries.
# If left empty, the pipeline will fall back to local rule-based models automatically.
GEMINI_API_KEY=

# Anomaly Thresholds
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_MEDIAN_MULTIPLIER=3.0
RAPID_TRANSACTION_WINDOW_MINUTES=10
